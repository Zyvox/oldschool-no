{
  "name": "oldschool-no",
  "version": "0.3.0",
  "description": "Oldschool — the 2008 Scandinavian web, brought back: a tinted frame, white boxes and underlined links with today's controls. Two themes (standard and retro), one accent seed, 63 components, 16 kB of CSS.",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "retro",
    "web-2000s",
    "accessibility",
    "universell-utforming"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zyvox/oldschool-no.git"
  },
  "style": "dist/oldschool.css",
  "main": "dist/esm/oldschool.js",
  "exports": {
    ".": "./dist/esm/oldschool.js",
    "./css": "./dist/oldschool.css",
    "./css/min": "./dist/oldschool.min.css",
    "./js": "./dist/esm/oldschool.js",
    "./js/*": "./dist/esm/*",
    "./tokens.json": "./dist/tokens.json",
    "./tailwind.css": "./dist/tailwind.css",
    "./tailwind-preset": "./dist/tailwind-preset.cjs",
    "./icons.svg": "./dist/icons.svg",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json",
    "./js/min": "./dist/oldschool.min.js"
  },
  "files": [
    "dist",
    "src",
    "tokens",
    "DESIGN.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/build.mjs --quiet && node scripts/check.mjs",
    "a11y": "node scripts/a11y.mjs",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=18.17"
  }
}
